# --- LLM (the "brain"), OpenAI-compatible ---
# The client uses the `openai` SDK pointed at a configurable base URL, so you can
# use Gemini's OpenAI-compatible endpoint, OpenRouter, a local proxy, or any
# OpenAI-compatible provider just by changing OPENAI_BASE_URL + OPENAI_MODEL.

# API key for your provider. For the Vercel AI Gateway, create one at
# https://vercel.com/dashboard (keys are prefixed with vck_).
OPENAI_API_KEY=sk_xxxxxxxxxxxxxx

# OpenAI-compatible base URL. Defaults to the Vercel AI Gateway endpoint.
# NOTE: the SDK appends "/chat/completions" to this base URL, so the base must
# already include any required version path. Examples:
#   Vercel AI Gateway:  https://ai-gateway.vercel.sh/v1   (the /v1 is required)
#   Gemini direct:      https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter:         https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://

# Model name is configurable so you can swap in any model from the chess
# leaderboard without changing code.
OPENAI_MODEL=google/gemini-4-argon

# Authorization scheme. Almost all providers use "Bearer" (the default). Set it
# only if your gateway expects something else, e.g. OPENAI_AUTH_SCHEME=Key.
# OPENAI_AUTH_SCHEME=Bearer

# The same OPENAI_* settings power the coach chat (press C in the GUI). It is
# only called when you ask a question, and answers are grounded in computed facts.

# --- Chess engine analysis (the "authority", final say on move quality) ---
# For the POC we reuse the hosted chess-api.com engine (Stockfish 18 NNUE-backed).
# NOTE: multiple candidate lines (variants/MultiPV) are only streamed over the
# WebSocket endpoint; the POST endpoint returns just the single best move. A
# local Stockfish UCI backend can replace this later via the same
# AnalysisProvider interface (see README "Deferred" section).
CHESS_API_WS_URL=wss://chess-api.com/v1

# Search depth requested from the engine (higher = stronger + slower).
CHESS_API_DEPTH=15

# Number of candidate lines to request (MultiPV-style). 3 powers the
# candidate-move comparison and "why this move / why not that one" coaching.
MULTIPV=5

# Blunder guardrail: if the LLM's chosen move is worse than the engine's best
# by more than this many centipawns, the engine's best move overrides it.
BLUNDER_THRESHOLD_CP=80

# --- Opponent: a Lichess Maia bot (human-like, beatable) ---
# When LICHESS_TOKEN is set, the GUI challenges LICHESS_BOT to a casual game on
# lichess.org from your normal account (Board API) and you play it in the app.
# Without a token the local engine plays instead.
# Create a token at https://lichess.org/account/oauth/token/create with ONLY the
# scopes "board:play" and "challenge:write".
LICHESS_TOKEN="lip_xxxxxxxxxxxxxxxxxx"

# maia1 (~1100), maia5 (~1500), maia9 (~1900).
LICHESS_BOT=maia5

# Real-time clock (Maia declines correspondence). 30+0 = classical.
LICHESS_CLOCK_MINUTES=30
LICHESS_INCREMENT=0
