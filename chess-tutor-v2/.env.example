# --- LLM (the "brain"), OpenAI-compatible ---
# The client uses the `openai` SDK pointed at a configurable base URL, so you can
# use Gemini's OpenAI-compatible endpoint, OpenRouter, a local proxy, or any
# OpenAI-compatible provider just by changing OPENAI_BASE_URL + OPENAI_MODEL.

# API key for your provider. For Gemini, create one at https://aistudio.google.com/apikey
OPENAI_API_KEY=your_api_key_here

# OpenAI-compatible base URL. Defaults to Gemini's OpenAI-compatible endpoint.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model name is configurable so you can swap in any model from the chess
# leaderboard without changing code.
OPENAI_MODEL=gemini-3.1-pro-preview

# --- Chess engine analysis (the "authority", final say on move quality) ---
# For the POC we reuse the hosted chess-api.com engine (Stockfish-backed) over
# HTTP. A local Stockfish UCI backend can replace it later via the same
# AnalysisProvider interface (see README "Deferred" section).
CHESS_API_URL=https://chess-api.com/v1

# Search depth requested from the engine (higher = stronger + slower).
CHESS_API_DEPTH=13

# Number of candidate lines to request (MultiPV-style). 3 powers the
# candidate-move comparison and "why this move / why not that one" coaching.
MULTIPV=3

# Blunder guardrail: if the LLM's chosen move is worse than the engine's best
# by more than this many centipawns, the engine's best move overrides it.
BLUNDER_THRESHOLD_CP=80
